#!/usr/bin/env node
import { spawn } from 'node:child_process';
import path from 'node:path';
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const ROOT_DIR = path.resolve(__dirname, '..');

const command = process.argv[2] || 'help';

function runScript(scriptPath, args = []) {
  const child = spawn(process.execPath, [scriptPath, ...args], {
    stdio: 'inherit',
    cwd: ROOT_DIR
  });
  child.on('exit', code => process.exit(code || 0));
}

switch (command) {
  case 'setup':
  case 'init':
  case 'config': {
    runScript(path.join(ROOT_DIR, 'setup.js'), process.argv.slice(3));
    break;
  }

  case 'doctor':
  case 'health':
  case 'check': {
    runScript(path.join(ROOT_DIR, 'bin', 'doctor.js'), process.argv.slice(3));
    break;
  }

  case 'start': {
    console.log('🚀 Starting Agent Browser Copilot Services...\n');
    const broker = spawn(process.execPath, [path.join(ROOT_DIR, 'broker', 'server.js')], {
      stdio: 'inherit',
      cwd: ROOT_DIR
    });

    const configPath = path.join(ROOT_DIR, 'config.json');
    if (fs.existsSync(configPath)) {
      try {
        const config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
        if (config?.telegram?.botToken) {
          const bot = spawn(process.execPath, [path.join(ROOT_DIR, 'telegram-bot', 'bot.js')], {
            stdio: 'inherit',
            cwd: ROOT_DIR
          });
          bot.on('exit', code => console.log(`Telegram Bot stopped with code ${code}`));
        }
      } catch {}
    }

    broker.on('exit', code => process.exit(code || 0));
    break;
  }

  case 'status': {
    const configPath = path.join(ROOT_DIR, 'config.json');
    const port = fs.existsSync(configPath) ? JSON.parse(fs.readFileSync(configPath, 'utf8'))?.server?.port || 8766 : 8766;
    fetch(`http://127.0.0.1:${port}/api/status`)
      .then(res => res.json())
      .then(st => {
        console.log('\n📊 Copilot Status:');
        console.log(`  Connected: ${st.connected ? 'YES (🟢)' : 'NO (⚪)'}`);
        console.log(`  Active Tab: ${st.activeTab?.title || 'None'}`);
        console.log(`  URL: ${st.activeTab?.url || 'Awaiting activity'}`);
        console.log(`  Watch Mode: ${st.watchMode}`);
        console.log(`  Connector: ${st.connector}\n`);
      })
      .catch(err => {
        console.error('❌ Could not reach broker server. Is it running?');
        process.exit(1);
      });
    break;
  }

  case 'pair': {
    const code = process.argv[3];
    const configPath = path.join(ROOT_DIR, 'config.json');
    const port = fs.existsSync(configPath) ? JSON.parse(fs.readFileSync(configPath, 'utf8'))?.server?.port || 8766 : 8766;
    if (code) {
      fetch(`http://127.0.0.1:${port}/work-edge/pair`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: code.toUpperCase() })
      })
        .then(res => res.json())
        .then(res => {
          if (res.ok) console.log(`✅ Paired browser: ${res.browserId}`);
          else console.log(`❌ Pairing failed: ${res.error}`);
        })
        .catch(err => console.error('Error connecting to broker:', err.message));
    } else {
      console.log('Open your Chrome extension side panel and enter the pairing code generated by your agent or bot.');
    }
    break;
  }

  case 'help':
  default: {
    console.log(`
🤖 AGENT BROWSER COPILOT CLI

Usage:
  copilot <command> [options]

Commands:
  setup           Launch interactive configuration wizard
  doctor          Run system health audit and diagnostic checks
  start           Start broker daemon and Telegram bot
  status          Show live connection status & active tab
  pair [code]     Pair browser with pairing code
  help            Show this usage guide
`);
    break;
  }
}
