{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Hermes Work Browser Copilot",
  "version": "0.4.0",
  "description": "Hermes AI agent side panel chat and secure browser execution bridge (Zero local install required).",
  "permissions": [
    "activeTab",
    "alarms",
    "offscreen",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://twinbrowser.bbos.tech/work-edge/*",
    "wss://twinbrowser.bbos.tech/work-edge/*",
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://twinbrowser.bbos.tech wss://twinbrowser.bbos.tech http://127.0.0.1 http://127.0.0.1:* http://localhost:*"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Hermes Work Browser Copilot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
